rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membership(homeId) {
      return get(/databases/$(database)/documents/homes/$(homeId)/members/$(request.auth.uid));
    }

    function activeMember(homeId) {
      return signedIn()
        && membership(homeId).data.active == true;
    }

    function hasRole(homeId, roles) {
      return activeMember(homeId)
        && membership(homeId).data.role in roles;
    }

    function validStatus(status) {
      return status in ['ON', 'OFF', 'ERROR', 'DISCONNECTED'];
    }

    function validPowerStatus(status) {
      return status in ['ON', 'OFF'];
    }

    function validFloorData(data) {
      return data.keys().hasOnly([
          'name', 'level', 'gridColumns', 'gridRows', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.level is int
        && data.gridColumns is int
        && data.gridColumns >= 4
        && data.gridColumns <= 40
        && data.gridRows is int
        && data.gridRows >= 4
        && data.gridRows <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validRoomData(homeId, floorId, data) {
      let floor = get(
        /databases/$(database)/documents/homes/$(homeId)/floors/$(floorId)
      ).data;

      return data.keys().hasOnly([
          'name', 'column', 'row', 'width', 'height', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.column is int
        && data.column >= 0
        && data.row is int
        && data.row >= 0
        && data.width is int
        && data.width > 0
        && data.height is int
        && data.height > 0
        && data.column + data.width <= floor.gridColumns
        && data.row + data.height <= floor.gridRows
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;
    }

    match /homes/{homeId} {
      allow read: if activeMember(homeId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasRole(homeId, ['OWNER']);
      allow delete: if false;

      match /members/{userId} {
        allow read: if activeMember(homeId);
        allow write: if hasRole(homeId, ['OWNER']);
      }

      match /floors/{floorId} {
        allow read: if activeMember(homeId);
        allow create: if hasRole(homeId, ['OWNER', 'OPERATOR'])
          && validFloorData(request.resource.data);
        allow update: if hasRole(homeId, ['OWNER', 'OPERATOR'])
          && validFloorData(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'level', 'gridColumns', 'gridRows', 'updatedAt'
          ]);
        allow delete: if hasRole(homeId, ['OWNER']);

        match /rooms/{roomId} {
          allow read: if activeMember(homeId);
          allow create: if hasRole(homeId, ['OWNER', 'OPERATOR'])
            && validRoomData(homeId, floorId, request.resource.data);
          allow update: if hasRole(homeId, ['OWNER', 'OPERATOR'])
            && validRoomData(homeId, floorId, request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'column', 'row', 'width', 'height', 'updatedAt'
            ]);
          allow delete: if hasRole(homeId, ['OWNER']);
        }
      }

      match /devices/{deviceId} {
        allow read: if activeMember(homeId);
        allow create: if hasRole(homeId, ['OWNER', 'OPERATOR'])
          && validStatus(request.resource.data.reported.status)
          && validPowerStatus(request.resource.data.desired.status);

        allow update: if ownerOrOperatorDesiredStateUpdate(homeId)
          || simulatorReportedStateUpdate(homeId);
        allow delete: if hasRole(homeId, ['OWNER']);

        match /events/{eventId} {
          allow read: if activeMember(homeId);
          allow write: if false;
        }
      }

      match /alerts/{alertId} {
        allow read: if activeMember(homeId);
        allow create, delete: if false;
        allow update: if activeMember(homeId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      }
    }

    function ownerOrOperatorDesiredStateUpdate(homeId) {
      return hasRole(homeId, ['OWNER', 'OPERATOR'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['desired', 'commandState', 'updatedAt'])
        && validPowerStatus(request.resource.data.desired.status)
        && request.resource.data.desired.requestedBy == request.auth.uid
        && request.resource.data.commandState == 'PENDING';
    }

    function simulatorReportedStateUpdate(homeId) {
      return hasRole(homeId, ['SIMULATOR'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reported', 'commandState', 'updatedAt'])
        && validStatus(request.resource.data.reported.status)
        && request.resource.data.commandState in ['IDLE', 'APPLIED', 'REJECTED'];
    }
  }
}
