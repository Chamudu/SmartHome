rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membership(homeId) {
      return get(/databases/$(database)/documents/homes/$(homeId)/members/$(request.auth.uid));
    }

    function activeMember(homeId) {
      return signedIn()
        && membership(homeId).data.active == true;
    }

    function hasRole(homeId, roles) {
      return activeMember(homeId)
        && membership(homeId).data.role in roles;
    }

    function validStatus(status) {
      return status in ['ON', 'OFF', 'ERROR', 'DISCONNECTED'];
    }

    function validPowerStatus(status) {
      return status in ['ON', 'OFF'];
    }

    function validFloorData(data) {
      return data.keys().hasOnly([
          'name', 'level', 'gridColumns', 'gridRows', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.level is int
        && data.gridColumns is int
        && data.gridColumns >= 4
        && data.gridColumns <= 40
        && data.gridRows is int
        && data.gridRows >= 4
        && data.gridRows <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validRoomData(homeId, floorId, data) {
      let floor = get(
        /databases/$(database)/documents/homes/$(homeId)/floors/$(floorId)
      ).data;

      return data.keys().hasOnly([
          'name', 'column', 'row', 'width', 'height', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.column is int
        && data.column >= 0
        && data.row is int
        && data.row >= 0
        && data.width is int
        && data.width > 0
        && data.height is int
        && data.height > 0
        && data.column + data.width <= floor.gridColumns
        && data.row + data.height <= floor.gridRows
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validDevicePlacement(homeId, data) {
      let floor = get(
        /databases/$(database)/documents/homes/$(homeId)/floors/$(data.floorId)
      ).data;

      return data.floorId is string
        && (data.roomId == null || data.roomId is string)
        && data.position.keys().hasOnly(['column', 'row'])
        && data.position.column is int
        && data.position.row is int
        && data.position.column >= 0
        && data.position.row >= 0
        && data.position.column < floor.gridColumns
        && data.position.row < floor.gridRows
        && (data.roomId == null || validDeviceRoomPlacement(homeId, data));
    }

    function validDeviceRoomPlacement(homeId, data) {
      let room = get(
        /databases/$(database)/documents/homes/$(homeId)/floors/$(data.floorId)/rooms/$(data.roomId)
      ).data;

      return data.roomId is string
        && data.position.column >= room.column
        && data.position.column < room.column + room.width
        && data.position.row >= room.row
        && data.position.row < room.row + room.height;
    }

    function validDeviceConfig(data) {
      return (data.profile == 'OUTLET' && data.config.keys().hasOnly([]))
        || (data.profile == 'MULTI_SWITCH'
          && data.config.keys().hasOnly(['channels'])
          && validSwitchChannels(data.config.channels))
        || (data.profile == 'SAFETY_OUTLET'
          && data.config.keys().hasOnly([
            'maxOnDurationSeconds', 'activatedAt', 'cutoffDueAt'
          ])
          && data.config.maxOnDurationSeconds is int
          && data.config.maxOnDurationSeconds >= 60
          && data.config.maxOnDurationSeconds <= 14400
          && data.config.activatedAt == null
          && data.config.cutoffDueAt == null)
        || (data.profile == 'LIGHT'
          && data.config.keys().hasOnly(['schedule'])
          && data.config.schedule.keys().hasOnly([
            'enabled', 'startLocalTime', 'endLocalTime', 'timezone', 'lastEvaluatedAt'
          ])
          && data.config.schedule.enabled == false
          && validLocalTime(data.config.schedule.startLocalTime)
          && validLocalTime(data.config.schedule.endLocalTime)
          && data.config.schedule.startLocalTime != data.config.schedule.endLocalTime
          && data.config.schedule.timezone is string
          && data.config.schedule.timezone.size() > 0
          && data.config.schedule.timezone.size() <= 64
          && data.config.schedule.lastEvaluatedAt == null)
        || (data.profile == 'CAMERA'
          && data.config.keys().hasOnly(['mediaType', 'mediaUri', 'capturedAt'])
          && data.config.mediaType == 'SNAPSHOT'
          && data.config.mediaUri is string
          && data.config.mediaUri.matches('https://.*')
          && data.config.capturedAt is timestamp);
    }

    function validSwitchChannel(channel) {
      return channel.keys().hasOnly([
          'id', 'name', 'desiredStatus', 'reportedStatus', 'requestId'
        ])
        && channel.id is string
        && channel.name is string
        && channel.name.size() > 0
        && channel.desiredStatus == 'OFF'
        && channel.reportedStatus == 'OFF'
        && channel.requestId == null;
    }

    function validSwitchChannels(channels) {
      return channels is list
        && channels.size() in [2, 3, 5]
        && validSwitchChannel(channels[0])
        && validSwitchChannel(channels[1])
        && (channels.size() < 3 || validSwitchChannel(channels[2]))
        && (channels.size() < 5 || (
          validSwitchChannel(channels[3]) && validSwitchChannel(channels[4])
        ));
    }

    function ownerWritableSwitchChannel(before, after) {
      return after == before || (
          after.diff(before).affectedKeys().hasOnly(['desiredStatus', 'requestId'])
          && validPowerStatus(after.desiredStatus)
          && after.requestId is string
          && after.requestId != before.requestId
        );
    }

    function simulatorWritableSwitchChannel(before, after) {
      return after == before || (
        after.diff(before).affectedKeys().hasOnly(['reportedStatus'])
        && validStatus(after.reportedStatus)
      );
    }

    function ownerWritableSwitchChannels(before, after) {
      return after is list
        && before.size() == after.size()
        && after.size() in [2, 3, 5]
        && ownerWritableSwitchChannel(before[0], after[0])
        && ownerWritableSwitchChannel(before[1], after[1])
        && (after.size() < 3 || ownerWritableSwitchChannel(before[2], after[2]))
        && (after.size() < 5 || (
          ownerWritableSwitchChannel(before[3], after[3])
          && ownerWritableSwitchChannel(before[4], after[4])
        ));
    }

    function simulatorWritableSwitchChannels(before, after) {
      return after is list
        && before.size() == after.size()
        && after.size() in [2, 3, 5]
        && simulatorWritableSwitchChannel(before[0], after[0])
        && simulatorWritableSwitchChannel(before[1], after[1])
        && (after.size() < 3 || simulatorWritableSwitchChannel(before[2], after[2]))
        && (after.size() < 5 || (
          simulatorWritableSwitchChannel(before[3], after[3])
          && simulatorWritableSwitchChannel(before[4], after[4])
        ));
    }

    function validEventOrigin(origin) {
      return origin in ['ANDROID', 'SIMULATOR', 'AUTOMATION', 'SYSTEM'];
    }

    function validEventMetadata(metadata) {
      return metadata is map
        && metadata.keys().hasOnly(['channelId'])
        && (!('channelId' in metadata) || metadata.channelId is string);
    }

    function validEventData(data) {
      return data.keys().hasOnly([
          'type', 'fromStatus', 'toStatus', 'origin', 'actorId',
          'requestId', 'reason', 'occurredAt', 'metadata'
        ])
        && data.type == 'STATE_REPORTED'
        && (data.fromStatus == null || validStatus(data.fromStatus))
        && validStatus(data.toStatus)
        && validEventOrigin(data.origin)
        && (data.actorId == null || data.actorId is string)
        && (data.requestId == null || data.requestId is string)
        && (data.reason == null || data.reason is string)
        && data.occurredAt == request.time
        && validEventMetadata(data.metadata);
    }

    function validAlertData(data) {
      return data.keys().hasOnly([
          'deviceId', 'eventId', 'type', 'severity', 'message', 'createdAt', 'readBy'
        ])
        && data.deviceId is string
        && (data.eventId == null || data.eventId is string)
        && data.type in ['APP_TOGGLE', 'MANUAL_TOGGLE']
        && data.severity in ['INFO', 'WARNING', 'CRITICAL']
        && data.message is string
        && data.message.size() > 0
        && data.createdAt == request.time
        && data.readBy is map
        && data.readBy.size() == 0;
    }

    function validNewDevice(homeId, data) {
      return data.keys().hasOnly([
          'name', 'profile', 'floorId', 'roomId', 'position', 'desired',
          'reported', 'commandState', 'config', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.profile in ['OUTLET', 'MULTI_SWITCH', 'SAFETY_OUTLET', 'LIGHT', 'CAMERA']
        && validDevicePlacement(homeId, data)
        && data.desired.keys().hasOnly([
          'status', 'requestId', 'requestedBy', 'requestedAt'
        ])
        && data.desired.status == 'OFF'
        && data.desired.requestId == null
        && data.desired.requestedBy == null
        && data.desired.requestedAt == null
        && data.reported.keys().hasOnly([
          'status', 'requestId', 'updatedAt', 'errorCode'
        ])
        && data.reported.status == 'OFF'
        && data.reported.requestId == null
        && data.reported.updatedAt is timestamp
        && data.reported.errorCode == null
        && data.commandState == 'IDLE'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validDeviceConfig(data);
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;
    }

    match /homes/{homeId} {
      allow read: if activeMember(homeId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasRole(homeId, ['OWNER']);
      allow delete: if false;

      match /members/{userId} {
        allow read: if activeMember(homeId);
        allow write: if hasRole(homeId, ['OWNER']);
      }

      match /floors/{floorId} {
        allow read: if activeMember(homeId);
        allow create: if hasRole(homeId, ['OWNER', 'OPERATOR'])
          && validFloorData(request.resource.data);
        allow update: if hasRole(homeId, ['OWNER', 'OPERATOR'])
          && validFloorData(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'level', 'gridColumns', 'gridRows', 'updatedAt'
          ]);
        allow delete: if hasRole(homeId, ['OWNER']);

        match /rooms/{roomId} {
          allow read: if activeMember(homeId);
          allow create: if hasRole(homeId, ['OWNER', 'OPERATOR'])
            && validRoomData(homeId, floorId, request.resource.data);
          allow update: if hasRole(homeId, ['OWNER', 'OPERATOR'])
            && validRoomData(homeId, floorId, request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'column', 'row', 'width', 'height', 'updatedAt'
            ]);
          allow delete: if hasRole(homeId, ['OWNER']);
        }
      }

      match /devices/{deviceId} {
        allow read: if activeMember(homeId);
        allow create: if hasRole(homeId, ['OWNER', 'OPERATOR'])
          && validNewDevice(homeId, request.resource.data);

        allow update: if ownerOrOperatorDesiredStateUpdate(homeId)
          || simulatorReportedStateUpdate(homeId)
          || ownerOrOperatorPlacementUpdate(homeId)
          || ownerOrOperatorSwitchChannelUpdate(homeId)
          || simulatorSwitchChannelUpdate(homeId)
          || ownerOrOperatorLightScheduleUpdate(homeId);
        allow delete: if hasRole(homeId, ['OWNER']);

        match /events/{eventId} {
          allow read: if activeMember(homeId);
          allow create: if hasRole(homeId, ['SIMULATOR'])
            && validEventData(request.resource.data);
          allow update, delete: if false;
        }
      }

      match /alerts/{alertId} {
        allow read: if activeMember(homeId);
        allow create: if hasRole(homeId, ['SIMULATOR'])
          && validAlertData(request.resource.data);
        allow delete: if false;
        allow update: if activeMember(homeId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys()
            .hasOnly([request.auth.uid])
          && request.resource.data.readBy[request.auth.uid] is timestamp;
      }
    }

    function ownerOrOperatorDesiredStateUpdate(homeId) {
      return hasRole(homeId, ['OWNER', 'OPERATOR'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['desired', 'commandState', 'updatedAt'])
        && validPowerStatus(request.resource.data.desired.status)
        && request.resource.data.desired.requestedBy == request.auth.uid
        && request.resource.data.commandState == 'PENDING';
    }

    function simulatorReportedStateUpdate(homeId) {
      return hasRole(homeId, ['SIMULATOR'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reported', 'commandState', 'updatedAt'])
        && validStatus(request.resource.data.reported.status)
        && request.resource.data.commandState in ['IDLE', 'APPLIED', 'REJECTED'];
    }

    function ownerOrOperatorPlacementUpdate(homeId) {
      return hasRole(homeId, ['OWNER', 'OPERATOR'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['floorId', 'roomId', 'position', 'updatedAt'])
        && validDevicePlacement(homeId, request.resource.data);
    }

    function ownerOrOperatorSwitchChannelUpdate(homeId) {
      return hasRole(homeId, ['OWNER', 'OPERATOR'])
        && resource.data.profile == 'MULTI_SWITCH'
        && request.resource.data.profile == 'MULTI_SWITCH'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['config', 'updatedAt'])
        && request.resource.data.config.keys().hasOnly(['channels'])
        && ownerWritableSwitchChannels(
          resource.data.config.channels,
          request.resource.data.config.channels
        );
    }

    function validLocalTime(value) {
      return value is string
        && value.matches('(?:[01][0-9]|2[0-3]):[0-5][0-9]');
    }

    function ownerOrOperatorLightScheduleUpdate(homeId) {
      return hasRole(homeId, ['OWNER', 'OPERATOR'])
        && resource.data.profile == 'LIGHT'
        && request.resource.data.profile == 'LIGHT'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['config', 'updatedAt'])
        && request.resource.data.config.keys().hasOnly(['schedule'])
        && request.resource.data.config.schedule.keys().hasOnly([
          'enabled', 'startLocalTime', 'endLocalTime', 'timezone', 'lastEvaluatedAt'
        ])
        && request.resource.data.config.schedule.diff(resource.data.config.schedule)
          .affectedKeys().hasOnly(['enabled', 'startLocalTime', 'endLocalTime', 'timezone'])
        && request.resource.data.config.schedule.enabled is bool
        && validLocalTime(request.resource.data.config.schedule.startLocalTime)
        && validLocalTime(request.resource.data.config.schedule.endLocalTime)
        && request.resource.data.config.schedule.startLocalTime
          != request.resource.data.config.schedule.endLocalTime
        && request.resource.data.config.schedule.timezone is string
        && request.resource.data.config.schedule.timezone.size() > 0
        && request.resource.data.config.schedule.timezone.size() <= 64;
    }

    function simulatorSwitchChannelUpdate(homeId) {
      return hasRole(homeId, ['SIMULATOR'])
        && resource.data.profile == 'MULTI_SWITCH'
        && request.resource.data.profile == 'MULTI_SWITCH'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['config', 'updatedAt'])
        && request.resource.data.config.keys().hasOnly(['channels'])
        && simulatorWritableSwitchChannels(
          resource.data.config.channels,
          request.resource.data.config.channels
        );
    }
  }
}
